# Copy to .env.local and fill in. Never commit real values.

# Supabase → Project Settings → API (or `npx supabase status` for local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" / publishable key. Safe for the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the app, used in auth email links.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: The app does NOT need the Supabase service-role key. Do not add it here.
